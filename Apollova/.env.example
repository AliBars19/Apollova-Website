# .env.example — COMMITTED (safe to commit, no real secrets)
# Copy to .env.local and fill in the real values.

# ── YouTube OAuth ─────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# ── TikTok OAuth ──────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# ── Site Access ───────────────────────────────────────────────────────────────
# Password for the /gate page that protects the admin dashboard
SITE_PASSWORD=your_site_password

# ── License HMAC Signing Secret ───────────────────────────────────────────────
# Shared secret between the server and Apollova.exe.
# MUST match HMAC_SECRET in Apollova-Installer/assets/apollova_secrets.py
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=your_64_char_hex_secret

# ── Base URL ────────────────────────────────────────────────────────────────
# Production domain for OAuth redirects and scheduler callbacks
NEXT_PUBLIC_BASE_URL=https://apollova.co.uk
